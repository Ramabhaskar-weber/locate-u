# Locate U — copy to .env (never commit .env). Only VITE_* values reach the browser bundle.
APP_NAME=Locate U
APP_ENV=development            # development | test | production
DEBUG=true

# Frontend (public — never put secrets in VITE_ variables)
VITE_API_BASE_URL=/api/v1      # same-origin via Vite proxy; or http://localhost:8000/api/v1
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECRET_KEY=replace-with-output-of-python-c-import-secrets-print-secrets-token-urlsafe-48
ACCESS_TOKEN_MINUTES=10080

# Database: PostgreSQL + PostGIS (recommended). Leave unset to use a local SQLite file for quick dev.
DATABASE_URL=postgresql+psycopg://locate_user:password@localhost:5432/locate_u
AUTO_SETUP=true                # run migrations + import India data on startup if empty

# Map & geocoding (free, OSM-compatible; respect their usage policies)
MAP_PROVIDER=osm
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=                # recommended by the Nominatim policy (contact for your deployment)
NOMINATIM_MIN_INTERVAL_SECONDS=1.0
GEOCODE_CACHE_DAYS=30
HTTP_USER_AGENT=LocateU/1.0 (self-hosted travel companion)

INDIA_DATA_DIR=../data/processed/india

# Free, key-less preview providers (set false to disable)
FEATURE_WEATHER=true           # Open-Meteo (non-commercial free tier)
FEATURE_WIKIPEDIA=true
FEATURE_NEARBY=true            # Overpass API (OSM)
RATE_LIMIT_PER_MINUTE=120

# Future integrations: leave EMPTY until explicitly approved (they are not used by the code).
GEMINI_API_KEY=
WEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=
